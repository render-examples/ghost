[mysqld]
# Carried over from render-examples/mysql
default-authentication-plugin=mysql_native_password
bind-address=0.0.0.0

# Low-memory tuning for a 512 MB instance serving a single Ghost site

# Biggest win: performance_schema alone takes ~150-250 MB
performance_schema=OFF
# X Protocol plugin (port 33060) is unused by Ghost
mysqlx=OFF
# Binary log is only needed for replication/point-in-time recovery, and fills the disk
skip-log-bin
skip-name-resolve

# Ghost uses a pool of at most 10 connections
max_connections=30
thread_cache_size=8

table_open_cache=256
table_open_cache_instances=1
table_definition_cache=400

# A Ghost database is usually well under 100 MB
innodb_buffer_pool_size=128M
innodb_log_buffer_size=8M

key_buffer_size=8M
tmp_table_size=16M
max_heap_table_size=16M
